# ────────────────────────────────────────────────────────────────
#  RL Nexus Admin Dashboard · lokale Entwicklung
#  Diese Datei gehört nicht ins Git. Werte immer in "..." setzen.
#  Im Betrieb setzt docker-compose.prod.yml im Ordner RL Nexus Bot alle
#  Werte, dort braucht es diese Datei nicht.
# ────────────────────────────────────────────────────────────────

# ── Aus der .env des Bots übernehmen ────────────────────────────
# Gleiche Namen wie dort, also einfach herüberkopieren.
#
# Die Produktiv-Application. Sie gilt im Betrieb und bei
# "npm run dev:server:live".
CLIENT_ID="DEINE_APPLICATION_ID"
CLIENT_SECRET="DEIN_CLIENT_SECRET"
CLIENT_TOKEN="DEIN_BOT_TOKEN"

# Die Dev-Application. Sie gilt bei "npm run dev" und "npm run
# dev:server", also mit --dev. Die Rollen prüft das Dashboard dann
# auf dem Dev Server, auf dem der Dev-Bot sitzt. Leer heisst: Dev
# Server 1162553851187040326, Admin-Rolle 1162556186462261248,
# Developer-Rolle 1286386691925344390.
DEV_CLIENT_ID="DEINE_DEV_APPLICATION_ID"
DEV_CLIENT_SECRET="DEIN_DEV_CLIENT_SECRET"
DEV_CLIENT_TOKEN="DEIN_DEV_BOT_TOKEN"
DEV_ADMIN_GUILD_ID=""
DEV_ADMIN_ROLE_ID=""
DEV_DEVELOPER_ROLE_ID=""
# Muss genau derselbe Wert sein wie im Bot, sonst lehnt er die
# Tokens des Admin Dashboards ab.
SERVER_JWT_SECRET="DERSELBE_WERT_WIE_IM_BOT"
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_NAME="rlnexus"
DATABASE_USER="rlnexus"
DATABASE_PASSWORD="DEIN_DB_PASSWORT"
# Zweite Datenbank für die Backups der Discord-Server, auf demselben Server
# und mit denselben Zugangsdaten. Der Nutzer braucht Rechte darauf (README, „Backups“).
BACKUP_DATABASE_NAME="rlnexus_backups"
DEV_USER_IDs="DEINE_USER_ID"

# ── Zugang ──────────────────────────────────────────────────────
ADMIN_GUILD_ID="1547258700480253982"
ADMIN_ROLE_ID="1548701400031297619"
DEVELOPER_ROLE_ID="1548701516418912370"

# ── Adressen ────────────────────────────────────────────────────
# Unter dieser Adresse öffnest du das Admin Dashboard. Im Developer
# Portal muss <ADMIN_PUBLIC_URL>/api/auth/callback als Redirect
# stehen, und zwar bei der Application, mit der du gerade startest:
# lokal also bei der Dev-Application.
ADMIN_PUBLIC_URL="http://localhost:5174"
BOT_API_URL="http://localhost:3000"
WEBSITE_URL="http://localhost:5173"
# Der gebaute Ordner dist der Hauptseite. Gesetzt: Den Standardinhalt liest
# der Server von dort statt über WEBSITE_URL. Im Betrieb /website/dist.
WEBSITE_DIST=""

# ── Hinweis bei neuer Kontaktnachricht ──────────────────────────
# Das Kontaktformular geht als Mail an CONTACT_MAIL. Verschickt wird über
# das Postfach mit dieser Adresse aus "Postfächer verwalten" (Server und
# Passwort von dort). Die SMTP_*-Zeilen braucht es nur, wenn es das
# Postfach nicht gibt.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Wohin das Kontaktformular geht. Leer heisst: support@nexus-emb.de.
CONTACT_MAIL="support@nexus-emb.de"
# Discord: In den Kanaleinstellungen unter Integrationen einen
# Webhook anlegen und die Adresse hier eintragen. Sie ist eine
# Vollmacht für diesen Kanal, gehört also nicht ins Git.
CONTACT_WEBHOOK_URL=""
# Mit --dev (npm run dev) geht der Hinweis stattdessen hierhin, etwa in
# einen Kanal auf dem Dev Server. Leer: mit --dev kein Discord-Hinweis.
DEV_CONTACT_WEBHOOK_URL=""

# ── Postfach (Mailcow über IMAP und SMTP) ───────────────────────
# Alles freiwillig. Die Postfächer kommen im Admin Dashboard dazu,
# unter Postfach → Postfach hinzufügen, mit Adresse und Passwort.
#
# Eigener Schlüssel für die gespeicherten Passwörter, mindestens 32
# Zeichen (openssl rand -hex 32). Leer: abgeleitet aus SERVER_JWT_SECRET.
# Wer einen der beiden ändert, muss die Passwörter neu eintragen.
MAIL_KEY=""
# Vorschlag für die Server im Formular. Leer: mail.<Domain der Adresse>.
MAIL_IMAP_HOST=""
MAIL_IMAP_PORT="993"
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="465"

# ── Shop (Stripe) ───────────────────────────────────────────────
# Aus dem Stripe-Dashboard unter Entwickler → API-Schlüssel, das
# Webhook-Secret unter Entwickler → Webhooks beim Endpunkt
# https://nexus-emb.de/api/shop/stripe. Alle drei oder keinen. Leer: Der
# Shop verkauft nichts, das Admin Dashboard läuft trotzdem.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Mit --dev (npm run dev) gelten nur diese, und nur Testschlüssel
# (sk_test_…). Ein Live-Schlüssel hier verhindert den Start. Das
# Webhook-Secret zeigt "stripe listen --forward-to
# localhost:3001/public/shop/stripe" beim Start an.
DEV_STRIPE_SECRET_KEY=""
DEV_STRIPE_PUBLISHABLE_KEY=""
DEV_STRIPE_WEBHOOK_SECRET=""
# Absender der Shop-Mails. Das Postfach mit dieser Adresse muss unter
# Postfach → Postfächer verwalten eingetragen sein. Leer: noreply@nexus-emb.de.
SHOP_MAIL_FROM=""


# ── Statusmeldung in Discord ────────────────────────────────────
# In diesen Kanal schreibt das Admin Dashboard eine Nachricht mit
# dem Zustand von Bot, Bot-Dashboard und Webseite und hält sie
# aktuell. Der Bot muss den Kanal sehen und dort schreiben dürfen.
# Leer heisst: keine Statusmeldung.
STATUS_CHANNEL_ID="1554823112447754330"
# Mit --dev (npm run dev) gilt STATUS_CHANNEL_ID nicht. Dann geht die
# Meldung in diese Kanäle, mehrere mit Komma. Leer: #moderator-only
# (1211378072549326860) auf dem Dev Server. Der Dev-Bot muss dort schreiben dürfen.
DEV_STATUS_CHANNEL_IDS=""
# Die Adresse des Bot-Dashboards, als Knopf in der Statusmeldung.
DASHBOARD_URL="https://dashboard.nexus-emb.de"
# Die Statusseite und die Webseite, wie Besucher sie aufrufen: Knöpfe in der
# Statusmeldung, Links auf der Statusseite. Lokal geht auch http://localhost.
STATUS_URL="https://status.nexus-emb.de"
WEBSITE_PUBLIC_URL="https://nexus-emb.de"
# Mit --dev (npm run dev) lädt der Modul-Editor die Vorschau von hier statt
# von WEBSITE_PUBLIC_URL. Leer: http://localhost:5173, der Entwicklungsserver
# der Webseite.
DEV_WEBSITE_PUBLIC_URL=""
# Einladung zum Discord-Server für den Knopf "Discord" auf der Statusseite.
# Leer heisst: kein Knopf.
DISCORD_INVITE_URL=""

# ── Ordner und Port ─────────────────────────────────────────────
LOGS_DIR="../RL Nexus Bot/logs"
SITE_DIR="./data/site"
FLAGS_DIR="./data/flags"
PORT="3001"
