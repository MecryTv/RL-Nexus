# Wohin das Kontaktformular sendet (POST, JSON).
#
# /api/contact geht an den Admin-Server. Im Betrieb reicht nginx die
# Adresse dorthin weiter. Fehlt die Zeile, baut npm run build mit diesem Wert
# (vite.config.ts). Lokal leitet der Entwicklungsserver sie an
# http://localhost:3001 weiter, dafür muss das Admin Dashboard laufen.
#
# Leer: das Formular öffnet stattdessen das Mailprogramm des Besuchers mit
# fertig zusammengesetztem Text. Das geht ohne Server, kostet aber einen
# zweiten Klick.
VITE_CONTACT_ENDPOINT="/api/contact"

# Wer der Seite /vorschau Entwürfe schicken darf: die Adresse des Admin
# Dashboards. Leer: https://admin.nexus-emb.de, beim Entwicklungsserver
# http://localhost:5174.
VITE_ADMIN_ORIGIN=""
