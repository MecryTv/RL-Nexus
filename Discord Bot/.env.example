# ────────────────────────────────────────────────────────────────
#  RL Nexus Bot · Konfiguration
#  Diese Datei gehört NICHT ins Git. Werte immer in "..." setzen —
#  ein unmaskiertes # startet sonst einen Kommentar und der Wert
#  wird still leer.
#
#  Es gibt keine config.json mehr: alles steht hier. Wer im
#  Dashboard welche Gruppe hat, steht in der Datenbank und wird
#  unter /dashboard/admins vergeben — nicht in dieser Datei.
# ────────────────────────────────────────────────────────────────

# ── Discord · Produktion ────────────────────────────────────────
CLIENT_TOKEN="DEIN_BOT_TOKEN"
CLIENT_ID="DEINE_APPLICATION_ID"
# Nur fuers Dashboard - OAuth2 > Client Secret im Developer Portal
CLIENT_SECRET="DEIN_CLIENT_SECRET"

# ── Discord · Entwicklung (--dev) ───────────────────────────────
DEV_CLIENT_TOKEN="DEIN_BOT_TOKEN"
DEV_CLIENT_ID="DEINE_APPLICATION_ID"
DEV_CLIENT_SECRET="DEIN_CLIENT_SECRET"
# Server, auf dem Commands im Dev-Modus sofort registriert werden
DEV_GUILD_ID="DEINE_DEV_SERVER_ID"
# Kommagetrennt. Schaltet die Entwickler-Befehle frei und ist der
# Einstieg ins Admin-Dashboard, ueber das alle weiteren Gruppen
# vergeben werden - deshalb steht diese eine Liste noch hier.
DEV_USER_IDs="DEINE_USER_ID"

# ── Datenbank (MariaDB) ─────────────────────────────────────────
# Leer lassen heisst: der Bot laeuft ohne Datenbank weiter.
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_NAME="rlnexus"
DATABASE_POOL_LIMIT="5"
DATABASE_USER="rlnexus"
# Nur fuer Docker auf dem eigenen Rechner: Root-Konto des Containers,
# phpMyAdmin-Login. Auf dem Server laeuft MariaDB ohne Docker, dort ungenutzt.
DATABASE_ROOT_PASSWORD="DEIN_ROOT_PASSWORT"
DATABASE_PASSWORD="DEIN_DB_PASSWORT"

# ── Webserver ───────────────────────────────────────────────────
# Neues Secret erzeugen: npm run token -- --secret
SERVER_JWT_SECRET="MIT npm run token -- --secret ERZEUGEN"
SERVER_PORT="3000"
# Die eigene Domain des Dashboards. Im --dev Modus ungenutzt: dort laeuft alles
# unter http://localhost:<SERVER_PORT>/dashboard, im Betrieb liegt das Dashboard
# an der Wurzel dieser Adresse.
SERVER_PUBLIC_URL="https://dashboard.nexus-emb.de"
# Die Hauptseite. Das Dashboard verlinkt in der Fusszeile dorthin.
SITE_PUBLIC_URL="https://nexus-emb.de"
# Das Admin Dashboard für das Modul Backups. Lokal der Admin-Server auf 3001,
# im Betrieb setzt docker-compose.prod.yml http://admin:3001.
ADMIN_INTERNAL_URL="http://localhost:3001"
SERVER_JWT_EXPIRES_IN="30d"
SERVER_RATE_LIMIT_MAX="100"
SERVER_RATE_LIMIT_WINDOW="1 minute"

# ── Discord-Sonstiges ───────────────────────────────────────────
# Privilegiertes Intent - nur an, wenn es im Developer Portal
# ebenfalls an ist, sonst weist Discord den Login rundweg ab.
GUILD_MEMBER_INTENT="false"
# Ebenfalls privilegiert (Presence Intent) - nur fuer die Live-Rolle des
# Twitch Notifiers. Aus = alles andere am Notifier laeuft trotzdem.
GUILD_PRESENCE_INTENT="false"

# ── Rocket League (prime.rocketplanet.gg) ───────────────────────
# Raenge fuer /rank, die RL Team-Uebersicht und Rank Roles. Token unter
# https://prime.rocketplanet.gg/access holen. Leer = keine Raenge.
PRIME_API_TOKEN=""

# ── Twitch Notifier ─────────────────────────────────────────────
# Eine kostenlose App unter dev.twitch.tv/console/apps anlegen
# (OAuth Redirect: http://localhost, Kategorie: Chat Bot) und
# Client-ID und Secret hier eintragen. Leer = keine Live-Meldungen.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# ── YouTube Notifier ────────────────────────────────────────────
# Nur fuer Livestreams noetig - Videos und Shorts kommen ohne
# Schluessel aus dem Kanal-Feed. Schluessel: console.cloud.google.com
# > APIs > "YouTube Data API v3" aktivieren > Anmeldedaten > API-Schluessel.
YOUTUBE_API_KEY=""

# ── Fehlermeldungen (Pop-up im Dashboard und /fehler) ───────────
# Postfach, ueber das der Bot die Meldungen an support@nexus-emb.de
# schickt. Port 465 = TLS, 587 = STARTTLS. SMTP_FROM leer = SMTP_USER.
# Leer = das Pop-up oeffnet stattdessen das Mailprogramm.
SMTP_HOST="mail.nexus-emb.de"
SMTP_PORT="465"
SMTP_USER="support@nexus-emb.de"
SMTP_PASSWORD=""
SMTP_FROM=""

# ── Admin Dashboard (admin.nexus-emb.de) ────────────────────────
# Wer hinein darf: Mitglieder dieses Servers mit einer der beiden Rollen.
# Liest nur das Admin Dashboard, der Bot braucht sie nicht.
ADMIN_GUILD_ID="1547258700480253982"
ADMIN_ROLE_ID="1548701400031297619"
DEVELOPER_ROLE_ID="1548701516418912370"
# Das Admin Dashboard nimmt dieselben CLIENT_*-Werte wie der Bot. Im Betrieb
# die produktiven, lokal mit "--dev" die DEV_*-Werte von oben. Dafuer muss der
# Dev-Bot auf ADMIN_GUILD_ID sein, sonst kann er die Rollen nicht lesen.
#
# Wohin das Kontaktformular geht (leer: support@nexus-emb.de) und, falls
# gesetzt, der Hinweis in einen Discord-Kanal. Verschickt wird ueber das
# Postfach mit dieser Adresse aus "Postfaecher verwalten" im Admin
# Dashboard. Die SMTP_*-Werte oben braucht das Admin Dashboard nur, wenn
# es das Postfach nicht gibt, der Bot aber immer fuer /fehler.
CONTACT_MAIL="support@nexus-emb.de"
CONTACT_WEBHOOK_URL=""
# Das Postfach im Admin Dashboard: Mailcow per IMAP und SMTP. Alles
# freiwillig, die Postfaecher kommen in der Oberflaeche dazu.
# Eigener Schluessel fuer die gespeicherten Passwoerter, mindestens 32 Zeichen
# (openssl rand -hex 32). Leer: abgeleitet aus SERVER_JWT_SECRET.
# Wer einen der beiden aendert, muss die Passwoerter neu eintragen.
MAIL_KEY=""
# Der Mailserver auf diesem Server (MAILCOW_HOSTNAME aus mailcow.conf).
# Leer heisst: mail.nexus-emb.de.
MAIL_DOMAIN=""
# Vorschlag fuer die Server im Formular. Leer heisst: MAIL_DOMAIN mit 993 und 465.
MAIL_IMAP_HOST=""
MAIL_IMAP_PORT=""
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT=""
# Shop des Admin Dashboards (Stripe). Liest nur der Container "admin".
# Aus dem Stripe-Dashboard, alle drei oder keinen. Leer: der Shop
# verkauft nichts, siehe README des Admin Dashboards unter "Shop".
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Absender der Shop-Mails. Das Postfach muss im Admin Dashboard unter
# Postfach -> Postfaecher verwalten eingetragen sein.
SHOP_MAIL_FROM="noreply@nexus-emb.de"
# Kanal, in dem das Admin Dashboard den Zustand von Bot, Bot-Dashboard und
# Webseite anzeigt und alle zwei Minuten nachzieht. Der Bot muss dort
# schreiben duerfen. Leer heisst: keine Statusmeldung.
STATUS_CHANNEL_ID="1554823112447754330"
# Einladung zum Discord-Server, als Knopf "Discord" auf der Statusseite.
# Leer heisst: kein Knopf.
DISCORD_INVITE_URL=""

# ── Betrieb (docker-compose.prod.yml) ───────────────────────────
# Die Domains. Leer lassen heisst: die echten (siehe docs/Hosting.md).
# Zertifikate und Weiterleitungen macht nginx auf dem Host, je Domain eine
# Datei unter /etc/nginx/sites-available/ (Vorlagen unter nginx/).
SITE_DOMAIN="nexus-emb.de"
DASHBOARD_DOMAIN="dashboard.nexus-emb.de"
ADMIN_DOMAIN="admin.nexus-emb.de"
# Die oeffentliche Statusseite (eigener Ordner, Daten vom Admin Dashboard).
STATUS_DOMAIN="status.nexus-emb.de"
# Wo die Ordner der drei Webseiten liegen, auf dem Server als absoluter Pfad:
# /var/www/nexus-emb.de und /var/www/status.nexus-emb.de (darin dist, das
# zeigen die Container rlnexus-website und rlnexus-status) und
# /var/www/admin.nexus-emb.de (daraus baut Compose das Image, dist ist die
# Oberflaeche). Leer heisst: genau diese Ordner.
WEBSITE_DIR=""
ADMIN_DIR=""
STATUS_DIR=""
