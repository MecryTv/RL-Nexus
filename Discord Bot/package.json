{
    "name": "rl-nexus",
    "version": "1.0.0",
    "description": "RL Nexus - Discord Bot to manage your Rocket League Organization",
    "keywords": [
        "RL Nexus",
        "TypeScript",
        "Discord.JS",
        "MecryTv",
        "Discord",
        "Bot"
    ],
    "license": "MIT",
    "author": "MecryTv",
    "type": "commonjs",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc --build && npm run build:dashboard",
        "build:dashboard": "tsc -p src/dashboard/tsconfig.json --noEmit && tsx src/scripts/BuildDashboard.ts",
        "check:admin": "tsx src/scripts/CheckAdmin.ts",
        "check:apply": "tsx src/scripts/CheckApply.ts",
        "check:antivillain": "tsx src/scripts/CheckAntiVillain.ts",
        "check:automod": "tsx src/scripts/CheckAutoMod.ts",
        "check:card": "tsx src/scripts/CheckCard.ts",
        "check:clips": "tsx src/scripts/CheckClips.ts",
        "check:community": "tsx src/scripts/CheckCommunity.ts",
        "check:dashboard": "tsx src/scripts/CheckDashboard.ts",
        "check:db": "tsx src/scripts/CheckDatabase.ts",
        "check:gallery": "tsx src/scripts/CheckGallery.ts",
        "check:image": "tsx src/scripts/CheckImage.ts",
        "check:levels": "tsx src/scripts/CheckLevels.ts",
        "check:leveldesign": "tsx src/scripts/CheckLevelDesign.ts",
        "check:studio": "tsx src/scripts/CheckStudio.ts",
        "check:lft": "tsx src/scripts/CheckLft.ts",
        "check:logging": "tsx src/scripts/CheckLogging.ts",
        "check:matchups": "tsx src/scripts/CheckMatchups.ts",
        "check:messages": "tsx src/scripts/CheckMessages.ts",
        "check:moderation": "tsx src/scripts/CheckModeration.ts",
        "check:presence": "tsx src/scripts/CheckPresence.ts",
        "check:prime": "tsx src/scripts/CheckPrime.ts",
        "check:rankroles": "tsx src/scripts/CheckRankRoles.ts",
        "check:rolelists": "tsx src/scripts/CheckRoleLists.ts",
        "check:serverbackup": "tsx src/scripts/CheckServerBackup.ts",
        "check:epicname": "tsx src/scripts/CheckEpicName.ts",
        "check:selfroles": "tsx src/scripts/CheckSelfRoles.ts",
        "check:sixmans": "tsx src/scripts/CheckSixMans.ts",
        "check:staffgrant": "tsx src/scripts/CheckStaffGrant.ts",
        "check:teams": "tsx src/scripts/CheckTeams.ts",
        "icons:teams": "tsx src/scripts/RenderTeamIcons.ts",
        "check:tickets": "tsx src/scripts/CheckTickets.ts",
        "check:voice": "tsx src/scripts/CheckVoice.ts",
        "check:welcome": "tsx src/scripts/CheckWelcome.ts",
        "dev": "npm run build:dashboard && tsx watch src/index.ts --dev",
        "dev:dashboard": "tsx src/scripts/BuildDashboard.ts --watch",
        "icons:ranks": "tsx src/scripts/MakeRankIcons.ts",
        "measure:dashboard": "tsx src/scripts/MeasureDashboard.ts",
        "start": "node .",
        "token": "tsx src/scripts/GenerateToken.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/rate-limit": "^11.2.0",
        "@napi-rs/canvas": "^1.0.9",
        "axios": "^1.19.0",
        "discord.js": "^14.27.0",
        "fastify": "^5.12.0",
        "glob": "^13.0.6",
        "jsqr": "^1.4.0",
        "lru-cache": "^11.5.2",
        "mariadb": "^3.5.4",
        "nodemailer": "^10.0.13"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/nodemailer": "^8.0.2",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
